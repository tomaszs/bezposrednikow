{
  "manifest_version": 3,
  "name": "Bezpośredników",
  "version": "2.3.0",
  "description": "Ukrywa oferty od pośredników na Pracuj.pl, Just Join IT i LinkedIn Jobs (lista firm)",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["*://*.pracuj.pl/*", "*://*.linkedin.com/*", "*://justjoin.it/*", "*://*.justjoin.it/*"],
  "action": {
    "default_title": "Bezpośredników",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://*.pracuj.pl/*"],
      "js": ["shared/normalize.js", "shared/match.js", "shared/pracuj-dom.js", "content/filter.js"],
      "css": ["content/filter.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.linkedin.com/*"],
      "js": [
        "shared/normalize.js",
        "shared/match.js",
        "shared/linkedin-dom.js",
        "content/filter-linkedin.js"
      ],
      "css": ["content/filter.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://justjoin.it/*", "*://*.justjoin.it/*"],
      "js": [
        "shared/normalize.js",
        "shared/match.js",
        "shared/justjoin-dom.js",
        "content/filter-justjoin.js"
      ],
      "css": ["content/filter.css"],
      "run_at": "document_idle"
    }
  ]
}
